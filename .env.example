DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/spy_chase?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/spy_chase?sslmode=require"
APP_ORIGIN="http://localhost:3000"
# Email OTP login and participant inbox offers: Gmail sender and its Google App Password (requires 2-Step Verification).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Set a unique strong password before running db:seed. Never commit .env.
SEED_PASSWORD=""

# Optional local roster seeding only (never reuse shared credentials for real participants)
SEED_AGENT_PASSWORD=""

# Public avatar delivery base URL (R2 custom domain or Vercel public Blob store).
# Leave empty until storage is connected; initials remain visible. No secrets here.
AVATAR_PUBLIC_BASE_URL=""
