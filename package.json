{
  "name": "spy-chase",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "user:password": "node --import tsx scripts/reset-password.ts",
    "test:integration": "npm run build && node tests/integration.mjs",
    "test:theme": "npm run build && node tests/theme-smoke.mjs",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "admin:grant": "node --import tsx scripts/grant-creator.ts",
    "db:seed:roster": "node --import tsx prisma/seed-roster.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@zxing/browser": "0.2.1",
    "next": "16.3.8",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "17.2.3",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
